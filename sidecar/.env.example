# GWriter NSM Sidecar — configuration template
# Copy this file to .env and edit, OR run: python setup.py
# setup.py will generate this file automatically.

# ── Model ──────────────────────────────────────────────────────────────────
# Leave NSM_MODEL_PATH empty to auto-resolve from HuggingFace cache
NSM_MODEL_PATH=
NSM_HF_MODEL_ID=google/gemma-3-2b-pt
NSM_MODEL_VARIANT=gemma-3-2b-pt

# ── SAE ────────────────────────────────────────────────────────────────────
# Leave NSM_SAE_PATH empty to auto-resolve from HuggingFace cache
NSM_SAE_PATH=
NSM_HF_SAE_REPO=google/gemma-scope-2b-pt-res
NSM_TARGET_LAYER=20
NSM_SAE_DICT_SIZE=16384

# ── Extraction ─────────────────────────────────────────────────────────────
NSM_TOP_K_FEATURES=20
NSM_ACTIVATION_THRESHOLD=0.5

# ── Server ─────────────────────────────────────────────────────────────────
NSM_PORT=8765
NSM_HOST=127.0.0.1
NSM_LOG_LEVEL=info

# ── Device: auto | cpu | cuda | mps ───────────────────────────────────────
NSM_DEVICE=auto

# ── Set to true on machines with <16GB RAM ─────────────────────────────────
# Requires: pip install bitsandbytes
NSM_QUANTIZE_INT8=false
